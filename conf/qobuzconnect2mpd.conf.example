

# qobuzconnect2mpd configuration

###########################################################################
# qobuzconnect2mpd — Qobuz Connect receiver daemon
#
# Run alongside upmpdcli to let the Qobuz mobile/desktop app cast audio
# directly to this device (similar to Spotify Connect).
# Start the daemon with:  qobuzconnect2mpd [-c /etc/upmpdcli.conf]
###########################################################################

# Device name shown in the Qobuz app.
# Defaults to the value of 'friendlyname'.
qconnectfriendlyname = Qobuz MPD

# Device type integer.  1=Speaker (default), 2=TV, 3=Phone, 4=Receiver
#qconnectdevicetype = 1

# TCP port for the HTTP device-endpoint server (the Qobuz app connects here).
qconnectport = 9093

# Stream format id.  5=MP3-320, 6=FLAC-lossless, 7=HiRes-96kHz, 27=HiRes-192kHz
# Defaults to qobuzformatid if set, otherwise 27.
qconnectformatid = 27

# Network interface for mDNS announcements (empty = auto-detect first
# non-loopback interface).
#qconnectiface =

# mDNS is how the Qobuz app discovers the device on the LAN. If the announcer
# cannot bind UDP port 5353 (another mDNS responder is holding it) startup
# fails loudly. Set to false only for cloud-only operation (no LAN discovery).
#qconnectmdnsrequired = true

# Path to the now-playing status file (two lines: title+timing, format info).
# Updated atomically every second while playing. Same as the -o command-line
# option; -o takes precedence if both are set.
# /tmp is writable by any user; change to a persistent location if preferred.
qconnectstatusfile = /tmp/qconnect2mpd-status.txt

# Log file for errors, retries, connection events, and now-playing changes.
# Entries are timestamped; the file is cleared on every daemon restart (not appended).
# /tmp is writable by any user; change to a persistent location if preferred.
qconnectlogfile = /tmp/qconnect2mpd.log

# Log verbosity: error (default), info, debug, or trace. -v enables debug;
# -vv enables trace. QC_LOGLEVEL or QC_DEBUG=1 can override an individual run.
#qconnectloglevel = info

# Unix socket path for IPC coordination with upmpdcli.
# When upmpdcli starts playing via UPnP it sends STOP to this socket;
# qconnect2mpd notifies upmpdcli with PLAYING/STOPPED events.
#qconnectsockpath = /var/run/upmpdcli-qconnect.sock

# Persistent state directory — holds the OAuth token (user_token) and the
# device UUID (device.uuid). One flat directory, created automatically if
# missing. Under a service account set it to the account's writable home so a
# stable device identity and cached login survive restarts.
# Default when unset: $XDG_STATE_HOME/qobuzconnect2mpd, else
# $HOME/.local/state/qobuzconnect2mpd.
qconnectstatedir = /var/db/qobuzconnect2mpd

# Qobuz authentication uses the browser OAuth flow and a locally cached token.
# Bootstrap the token once (opens a login URL, waits, then exits):
#     qobuzconnect2mpd -c /usr/local/etc/qobuzconnect2mpd.conf -L
# By default the token is stored as <qconnectstatedir>/user_token; override the
# full path here only if you need it somewhere else.
#qconnecttokenfile =
#qconnectappid =
#qconnectcfvalue =
