[Unit]
Description=Qobuz Connect to MPD bridge
After=network-online.target mpd.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=@QOBUZCONNECT2MPD_BIN@ -c %E/qobuzconnect2mpd/qobuzconnect2mpd.conf
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=default.target
