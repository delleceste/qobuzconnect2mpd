#!/bin/sh

# PROVIDE: qobuzconnect2mpd
# REQUIRE: NETWORKING FILESYSTEMS musicpd
# KEYWORD: shutdown
#
# Template generated as qobuzconnect2mpd.rc and installed as qobuzconnect2mpd.
# Do not edit the generated copy; edit this .in file instead.
#
# FreeBSD rc.d service script for qobuzconnect2mpd
# (Qobuz Connect receiver daemon that bridges the Qobuz app to MPD).
#
# Enable with:  sysrc qobuzconnect2mpd_enable=YES
# The daemon runs as an unprivileged user created by the FreeBSD install step.
# Override qobuzconnect2mpd_user, qobuzconnect2mpd_group,
# qobuzconnect2mpd_homedir, or
# qobuzconnect2mpd_config in rc.conf as needed.

PREFIX="@PREFIX@"
BINDIR="@BINDIR@"

. /etc/rc.subr

name="qobuzconnect2mpd"
rcvar="qobuzconnect2mpd_enable"

load_rc_config "$name"

: ${qobuzconnect2mpd_enable:="NO"}
: ${qobuzconnect2mpd_user:="qobuzconnect2mpd"}
: ${qobuzconnect2mpd_group:="qobuzconnect2mpd"}
: ${qobuzconnect2mpd_homedir:="/var/db/qobuzconnect2mpd"}
: ${qobuzconnect2mpd_flags:=""}
: ${qobuzconnect2mpd_config:="@QOBUZCONNECT2MPD_CONFIG@"}
# The pidfile goes in /var/run/<name>/, not in the service account's home: the
# home is 0700 (it holds the Qobuz token and cache), so rc.subr's check_pidfile
# could not traverse it when `service qobuzconnect2mpd onestatus` is run by an
# unprivileged user, and reported a running service as stopped.  /var/run is
# not writable after rc.subr drops privileges, but start_precmd below still
# runs as root and creates the directory owned by the service account.
: ${qobuzconnect2mpd_rundir:="/var/run/${name}"}
: ${qobuzconnect2mpd_pidfile:="${qobuzconnect2mpd_rundir}/qobuzconnect2mpd.pid"}

# No HOME juggling: the daemon locates its state directory from qconnectstatedir
# in the config. The nologin service account has no desktop home, so the daemon
# does not derive a state path from any home — it aborts if qconnectstatedir is
# unset. required_files below ensures the config (which sets it) is present.

# Services start with a minimal PATH that omits /usr/local/bin on FreeBSD.
export PATH="${BINDIR}:/usr/bin:/bin"

# daemon(8) backgrounds qobuzconnect2mpd (run in the foreground, without -d),
# writes its pidfile, and sends stdout/stderr to syslog. No -r: the daemon does
# not restart the child after service stop or a crash.
command="/usr/sbin/daemon"
procname="${BINDIR}/qobuzconnect2mpd"
pidfile="${qobuzconnect2mpd_pidfile}"

required_files="${qobuzconnect2mpd_config}"

command_args="-f -S -T ${name} -p ${qobuzconnect2mpd_pidfile} -t ${name} -- ${BINDIR}/qobuzconnect2mpd -c ${qobuzconnect2mpd_config} ${qobuzconnect2mpd_flags}"

start_precmd="qobuzconnect2mpd_precmd"

qobuzconnect2mpd_precmd()
{
	# Created as root before rc.subr drops privileges.
	if ! /usr/bin/id "${qobuzconnect2mpd_user}" >/dev/null 2>&1; then
		err 1 "user ${qobuzconnect2mpd_user} does not exist"
	fi
	if ! /usr/bin/getent group "${qobuzconnect2mpd_group}" >/dev/null 2>&1; then
		err 1 "group ${qobuzconnect2mpd_group} does not exist"
	fi
	# 0700: the home holds the Qobuz token and cache.
	/usr/bin/install -d -o "${qobuzconnect2mpd_user}" -g "${qobuzconnect2mpd_group}" -m 0700 "${qobuzconnect2mpd_homedir}"
	# 0755, and recreated on every start because /var/run does not survive a
	# reboot: the pid must stay readable so an unprivileged `onestatus` works.
	/usr/bin/install -d -o "${qobuzconnect2mpd_user}" -g "${qobuzconnect2mpd_group}" -m 0755 "${qobuzconnect2mpd_pidfile%/*}"
}

run_rc_command "$1"
